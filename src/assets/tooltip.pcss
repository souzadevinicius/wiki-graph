/* tooltip */
#tooltip {
  z-index: 20;
  position: absolute;

  &[hidden] {
    /* display: none; */
    opacity: 0;
    pointer-events: none;
  }
  transition: opacity 80ms linear;

  /* border: 2px solid #ddd; */
  box-shadow: 0 0 1px 2px hsl(0deg 1% 87%);

  display: flex;
  flex-direction: row;

  & > .text {
    background-color: #eee;
    padding: 0.5em 1em;

    overflow-y: auto;
    word-break: break-word;

    flex: 1 1 auto;
  }

  /* width: min(300px, 30vw); */
  width: 400px;
  & > img {
    max-width: 50%;
    height: auto;
    object-fit: cover;

    background-color: #fff;
  }

  & .text img {
    background-color: hsla(0, 100%, 100%, 0.6);
    max-width: 100%;
  }

  /* max-height: min(500px, 50vh); */
  max-height: 280px;
}

/* Book entity tooltip styles */
#tooltip .wiki-title {
  font-weight: 600;
  margin-bottom: 0.25em;
}

#tooltip .wiki-title a {
  color: #1a73e8;
  text-decoration: none;
}

#tooltip .wiki-title a:hover {
  text-decoration: underline;
}

#tooltip .entity-type {
  display: inline-block;
  font-size: 0.8em;
  padding: 0.1em 0.4em;
  border-radius: 3px;
  background: #e0e0e0;
  color: #333;
  margin-bottom: 0.25em;
}

#tooltip .mentions {
  font-size: 0.85em;
  color: #666;
  margin-top: 0.25em;
}
