/* tooltip */
#tooltip {
  position: fixed;
  z-index: 1100; /* above graph (z:40) and iframe */

  &[hidden] {
    opacity: 0;
    pointer-events: none;
  }
  transition: opacity 120ms ease, transform 120ms ease;

  background: #fff;
  border-radius: 10px;
  padding: 0.4rem;
  box-shadow: 0 8px 24px rgba(28, 50, 80, 0.08);

  display: flex;
  flex-direction: row;
  gap: 0.5rem;

  & > .text {
    background-color: transparent;
    padding: 0.25rem 0.6rem;

    overflow-y: auto;
    word-break: break-word;

    flex: 1 1 auto;
    color: var(--textColor);
  }

  width: 360px;
  & > img {
    max-width: 45%;
    height: auto;
    object-fit: cover;
    border-radius: 6px;
    background-color: #fff;
  }

  & .text img {
    background-color: transparent;
    max-width: 100%;
  }

  max-height: 360px;
}
